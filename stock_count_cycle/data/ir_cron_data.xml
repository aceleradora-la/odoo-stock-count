<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_stock_count_cycle" model="ir.cron">
            <field name="name">Recuento cíclico: generar recuentos</field>
            <field name="model_id" ref="model_stock_count_rule"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_counts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
