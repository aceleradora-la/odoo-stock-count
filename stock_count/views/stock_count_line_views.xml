<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_count_line_view_list" model="ir.ui.view">
        <field name="name">stock.count.line.list</field>
        <field name="model">stock.count.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" decoration-muted="state == 'skipped'" decoration-warning="state == 'recount'" decoration-success="state in ('approved', 'applied')">
                <field name="count_id" readonly="1"/>
                <field name="location_id" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="lot_id" readonly="1" optional="show"/>
                <field name="package_id" readonly="1" optional="hide"/>
                <field name="product_uom_id" readonly="1" optional="show"/>
                <field name="qty_theoretical" readonly="1" invisible="blind and not is_manager"/>
                <field name="qty_counted" readonly="state not in ('pending', 'counted') or count_state not in ('ready', 'counting', 'review')"/>
                <field name="counted_by_id" optional="show" readonly="1"/>
                <field name="qty_recount" readonly="state != 'recount'" optional="hide"/>
                <field name="recounted_by_id" readonly="1" optional="hide"/>
                <field name="qty_diff" invisible="blind and not is_manager" optional="show"/>
                <field name="diff_pct" invisible="blind and not is_manager" optional="hide"/>
                <field name="diff_value" invisible="blind and not is_manager" optional="hide"/>
                <field name="assigned_user_id" optional="show" readonly="1"/>
                <field name="reason_id" optional="show" readonly="count_state != 'review'"/>
                <field name="note" optional="hide" readonly="count_state != 'review'"/>
                <field name="moved_during_count" optional="hide"/>
                <field name="count_state" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'counted'" decoration-warning="state == 'recount'" decoration-success="state in ('approved', 'applied')"/>
                <field name="blind" column_invisible="1"/>
                <field name="is_manager" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="stock_count_line_view_search" model="ir.ui.view">
        <field name="name">stock.count.line.search</field>
        <field name="model">stock.count.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <field name="count_id"/>
                <filter name="mine" string="Mis líneas" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ('pending', 'recount'))]"/>
                <filter name="with_diff" string="Con diferencia" domain="[('qty_diff', '!=', 0), ('state', 'not in', ('pending', 'skipped'))]"/>
                <filter name="moved" string="Movidas durante el conteo" domain="[('moved_during_count', '=', True)]"/>
                <separator/>
                <filter name="active_counts" string="Recuentos activos" domain="[('count_state', 'in', ('ready', 'counting', 'review'))]"/>
                <filter name="applied_counts" string="Recuentos aplicados" domain="[('count_state', '=', 'done')]"/>
                <separator/>
                <filter name="count_date" string="Fecha del recuento" date="count_date"/>
                <group>
                    <filter name="group_count" string="Recuento" context="{'group_by': 'count_id'}"/>
                    <filter name="group_location" string="Ubicación" context="{'group_by': 'location_id'}"/>
                    <filter name="group_warehouse" string="Depósito" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_categ" string="Categoría" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_reason" string="Motivo" context="{'group_by': 'reason_id'}"/>
                    <filter name="group_user" string="Asignado a" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_counted_by" string="Contó" context="{'group_by': 'counted_by_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mes del recuento" context="{'group_by': 'count_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_count_line_view_pivot" model="ir.ui.view">
        <field name="name">stock.count.line.pivot</field>
        <field name="model">stock.count.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de recuentos" sample="1">
                <field name="location_id" type="row"/>
                <field name="count_date" interval="month" type="col"/>
                <field name="qty_diff" type="measure"/>
                <field name="diff_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="stock_count_line_view_graph" model="ir.ui.view">
        <field name="name">stock.count.line.graph</field>
        <field name="model">stock.count.line</field>
        <field name="arch" type="xml">
            <graph string="Análisis de recuentos" type="bar" sample="1" stacked="0">
                <field name="reason_id"/>
                <field name="diff_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="stock_count_line_action_analysis" model="ir.actions.act_window">
        <field name="name">Análisis de recuentos</field>
        <field name="res_model">stock.count.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="stock_count_line_view_search"/>
        <field name="context">{'search_default_applied_counts': 1, 'search_default_with_diff': 1, 'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay recuentos aplicados</p>
            <p>Cuando se apliquen recuentos, acá vas a poder cruzar diferencias por ubicación, producto, categoría, motivo, contador y mes.</p>
        </field>
    </record>

    <record id="stock_count_line_action_mine" model="ir.actions.act_window">
        <field name="name">Mis líneas de conteo</field>
        <field name="res_model">stock.count.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="stock_count_line_view_search"/>
        <field name="context">{'search_default_mine': 1, 'search_default_pending': 1, 'search_default_active_counts': 1, 'search_default_group_location': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tenés líneas pendientes de conteo</p>
            <p>Cuando el supervisor te asigne líneas de un recuento activo, van a aparecer acá.</p>
        </field>
    </record>
</odoo>
