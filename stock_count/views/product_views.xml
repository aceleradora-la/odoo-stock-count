<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 18: el embalaje de recuento se marca en la lista de embalajes del producto -->
    <record id="product_packaging_tree_view_stock_count" model="ir.ui.view">
        <field name="name">product.packaging.list.stock_count</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="after">
                <field name="stock_count_default" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="product_packaging_tree_view2_stock_count" model="ir.ui.view">
        <field name="name">product.packaging.list2.stock_count</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="after">
                <field name="stock_count_default" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="product_packaging_form_view_stock_count" model="ir.ui.view">
        <field name="name">product.packaging.form.stock_count</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty']" position="after">
                <field name="stock_count_default"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_stock_count" model="ir.ui.view">
        <field name="name">product.template.form.stock_count</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group name="stock_count" string="Recuento de inventario">
                    <group>
                        <field name="stock_count_lock_mode" placeholder="El del recuento"/>
                        <field name="stock_count_custom"/>
                    </group>
                    <group invisible="not stock_count_custom">
                        <field name="stock_count_recount_threshold_pct"/>
                        <field name="stock_count_recount_threshold_qty"/>
                        <field name="stock_count_auto_approve_pct"/>
                        <field name="stock_count_recount_min_value"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_category_form_view_stock_count" model="ir.ui.view">
        <field name="name">product.category.form.stock_count</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="stock_count" string="Recuento de inventario">
                    <group>
                        <field name="stock_count_lock_mode" placeholder="El del recuento"/>
                        <field name="stock_count_custom"/>
                    </group>
                    <group invisible="not stock_count_custom">
                        <field name="stock_count_recount_threshold_pct"/>
                        <field name="stock_count_recount_threshold_qty"/>
                        <field name="stock_count_auto_approve_pct"/>
                        <field name="stock_count_recount_min_value"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
