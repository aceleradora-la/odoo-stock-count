<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_count" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.stock_count</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="count_id" optional="show" readonly="1" decoration-warning="count_id"/>
            </xpath>
        </field>
    </record>
</odoo>
