<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_count_reason_view_list" model="ir.ui.view">
        <field name="name">stock.count.reason.list</field>
        <field name="model">stock.count.reason</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="location_dest_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="stock_count_reason_action" model="ir.actions.act_window">
        <field name="name">Motivos de diferencia</field>
        <field name="res_model">stock.count.reason</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Definí los motivos de diferencia</p>
            <p>Rotura, vencimiento, error de carga… El supervisor los asigna a cada línea con diferencia al revisar el recuento.</p>
        </field>
    </record>
</odoo>
