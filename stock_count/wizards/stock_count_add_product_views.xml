<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_count_add_product_view_form" model="ir.ui.view">
        <field name="name">stock.count.add.product.form</field>
        <field name="model">stock.count.add.product</field>
        <field name="arch" type="xml">
            <form string="Producto no esperado">
                <p class="text-muted">Un producto que está en la estantería pero no figura en el recuento. Se agrega con cantidad teórica cero y queda contado con la cantidad que indiques.</p>
                <group>
                    <field name="count_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="allowed_location_ids" invisible="1"/>
                    <field name="tracking" invisible="1"/>
                    <field name="location_id" options="{'no_create': True}"/>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="lot_id" invisible="tracking == 'none'" required="tracking != 'none'" context="{'default_product_id': product_id}"/>
                    <label for="qty_counted"/>
                    <div class="o_row">
                        <field name="qty_counted"/>
                        <field name="product_uom_id" readonly="1"/>
                    </div>
                    <field name="reason_id" options="{'no_create': True}"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_add" type="object" string="Agregar al recuento" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_count_add_product" model="ir.actions.act_window">
        <field name="name">Producto no esperado</field>
        <field name="res_model">stock.count.add.product</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
