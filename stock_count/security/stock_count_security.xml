<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_stock_count" model="ir.module.category">
            <field name="name">Recuento de inventario</field>
            <field name="parent_id" ref="base.module_category_inventory"/>
            <field name="sequence">25</field>
        </record>

        <record id="group_stock_count_user" model="res.groups">
            <field name="name">Contador</field>
            <field name="category_id" ref="module_category_stock_count"/>
            <field name="comment">Ve los recuentos donde está asignado y carga cantidades en sus líneas.</field>
        </record>

        <record id="group_stock_count_manager" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_stock_count"/>
            <field name="implied_ids" eval="[(4, ref('group_stock_count_user')), (4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Crea, confirma, revisa, aprueba y aplica recuentos. Incluye Inventario / Usuario para poder generar los ajustes.</field>
        </record>

        <record id="stock.group_stock_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_stock_count_manager'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="stock_count_rule_company" model="ir.rule">
            <field name="name">Recuento: multi-compañía</field>
            <field name="model_id" ref="model_stock_count"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="stock_count_line_rule_company" model="ir.rule">
            <field name="name">Línea de recuento: multi-compañía</field>
            <field name="model_id" ref="model_stock_count_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="stock_count_rule_user" model="ir.rule">
            <field name="name">Recuento: el contador ve los suyos</field>
            <field name="model_id" ref="model_stock_count"/>
            <field name="groups" eval="[(4, ref('group_stock_count_user'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('counter_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="stock_count_rule_manager" model="ir.rule">
            <field name="name">Recuento: el supervisor ve todos</field>
            <field name="model_id" ref="model_stock_count"/>
            <field name="groups" eval="[(4, ref('group_stock_count_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="stock_count_line_rule_user" model="ir.rule">
            <field name="name">Línea de recuento: el contador ve y carga las suyas</field>
            <field name="model_id" ref="model_stock_count_line"/>
            <field name="groups" eval="[(4, ref('group_stock_count_user'))]"/>
            <field name="domain_force">['|', ('assigned_user_id', '=', user.id), '&amp;', ('assigned_user_id', '=', False), ('count_id.counter_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="stock_count_line_rule_manager" model="ir.rule">
            <field name="name">Línea de recuento: el supervisor ve todas</field>
            <field name="model_id" ref="model_stock_count_line"/>
            <field name="groups" eval="[(4, ref('group_stock_count_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
